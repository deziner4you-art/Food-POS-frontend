  transfer_id          Int
  product_id           Int
  batch_id             Int?
  requested_quantity   Float
  transferred_quantity Float   @default(0)
  received_quantity    Float   @default(0)
  unit_cost            Float   @default(0)
  total_cost           Float   @default(0)
  remarks              String?

  transfer WarehouseTransfer @relation(fields: [transfer_id], references: [id])
  product  InventoryItem     @relation(fields: [product_id], references: [id])
  batch    InventoryBatch?   @relation(fields: [batch_id], references: [id])
