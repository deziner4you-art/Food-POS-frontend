  reference_module   String
  reference_id       String
  store_id           Int
  warehouse_id       Int?
  status             String    @default("DRAFT") // DRAFT, RESERVED, PARTIALLY_CONSUMED, CONSUMED, RELEASED, EXPIRED, CANCELLED
  reservation_date   DateTime  @default(now())
  expiry_date        DateTime?
  remarks            String?
  created_by         Int
  approved_by        Int?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  store Store                      @relation(fields: [store_id], references: [id])
