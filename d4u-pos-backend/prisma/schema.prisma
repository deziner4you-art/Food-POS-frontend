  reference_module String
  reference_id     String
  quantity_in      Float    @default(0)
  quantity_out     Float    @default(0)
  created_by       Int
  transaction_date DateTime @default(now())

  batch InventoryBatch @relation(fields: [batch_id], references: [id])
}

model BatchReservation {
  id               Int      @id @default(autoincrement())
  batch_id         Int
  reference_module String
  reference_id     String
  quantity         Float
  status           String   @default("RESERVED") // RESERVED, RELEASED, CONSUMED
  created_by       Int
  created_at       DateTime @default(now())

  batch InventoryBatch @relation(fields: [batch_id], references: [id])
}

model WarehouseTransfer {
  id                  Int       @id @default(autoincrement())
  transfer_number     String    @unique
  source_store_id     Int
  source_warehouse_id Int?
  dest_store_id       Int
  dest_warehouse_id   Int?
  status              String    @default("DRAFT") // DRAFT, PENDING_APPROVAL, APPROVED, IN_TRANSIT, RECEIVED, REJECTED, CANCELLED
  created_by          Int
  approved_by         Int?
  transfer_date       DateTime?
  received_date       DateTime?
  remarks             String?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

