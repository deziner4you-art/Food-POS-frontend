// ---------------------------------------------------------
// ENTERPRISE BANK RECONCILIATION
// ---------------------------------------------------------

model BankStatement {
  id                   Int      @id @default(autoincrement())
  store_id             Int
  account_id           Int      // Reference to GL Account (Cash/Bank)
  statement_date       DateTime
  opening_balance      Decimal  @db.Decimal(15, 4)
  closing_balance      Decimal  @db.Decimal(15, 4)
  status               String   @default("DRAFT") // DRAFT, IMPORTED, RECONCILED
  created_at           DateTime @default(now())

  store                Store    @relation(fields: [store_id], references: [id])
  account              Account  @relation(fields: [account_id], references: [id])
  lines                BankStatementLine[]
  reconciliation       BankReconciliation?

  @@index([store_id])
  @@index([account_id])
}

model BankStatementLine {
  id                   Int      @id @default(autoincrement())
  statement_id         Int
  transaction_date     DateTime
  description          String
  reference_number     String?
  amount               Decimal  @db.Decimal(15, 4)
  is_reconciled        Boolean  @default(false)
  matched_journal_line_id Int?  // Optional reference to the GL JournalEntryLine matched

  statement            BankStatement @relation(fields: [statement_id], references: [id])
  journal_line         JournalEntryLine? @relation(fields: [matched_journal_line_id], references: [id])

  @@index([statement_id])
  @@index([matched_journal_line_id])
}

model BankReconciliation {
  id                   Int      @id @default(autoincrement())
  store_id             Int
  statement_id         Int      @unique
  reconciliation_date  DateTime @default(now())
  status               String   @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED
  matched_amount       Decimal  @default(0.0) @db.Decimal(15, 4)
  unmatched_amount     Decimal  @default(0.0) @db.Decimal(15, 4)
  executed_by          Int

  store                Store         @relation(fields: [store_id], references: [id])
  statement            BankStatement @relation(fields: [statement_id], references: [id])
  adjustments          BankReconciliationAdjustment[]

  @@index([store_id])
}

model BankReconciliationAdjustment {
  id                   Int      @id @default(autoincrement())
  reconciliation_id    Int
  journal_entry_id     Int      @unique
  amount               Decimal  @db.Decimal(15, 4)
  reason               String
  created_at           DateTime @default(now())

  reconciliation       BankReconciliation @relation(fields: [reconciliation_id], references: [id])
  journal_entry        JournalEntry       @relation(fields: [journal_entry_id], references: [id])

  @@index([reconciliation_id])
}

// ---------------------------------------------------------
// ENTERPRISE TREASURY & CASH MANAGEMENT
// ---------------------------------------------------------

model BankAccount {
  id                   Int      @id @default(autoincrement())
  store_id             Int
  account_id           Int      @unique // Reference to GL Account
  bank_name            String
  account_number       String
  currency             String   @default("PKR")
  current_balance      Decimal  @default(0.0) @db.Decimal(15, 4)
  is_active            Boolean  @default(true)
  created_at           DateTime @default(now())

  store                Store    @relation(fields: [store_id], references: [id])
  account              Account  @relation(fields: [account_id], references: [id])
  transfers_out        BankTransfer[] @relation("TransferSource")
  transfers_in         BankTransfer[] @relation("TransferDestination")
  cash_transactions    CashTransaction[]
  cash_positions       CashPosition[]

  @@index([store_id])
}

model CashTransaction {
  id                   Int      @id @default(autoincrement())
  store_id             Int
  bank_account_id      Int
  transaction_date     DateTime @default(now())
  transaction_type     String   // INFLOW, OUTFLOW
  amount               Decimal  @db.Decimal(15, 4)
  description          String
  reference_type       String?  // e.g., RECEIPT, PAYMENT, ADJUSTMENT
  reference_id         String?
  journal_entry_id     Int?
  created_at           DateTime @default(now())

  store                Store         @relation(fields: [store_id], references: [id])
  bank_account         BankAccount   @relation(fields: [bank_account_id], references: [id])

  @@index([store_id])
  @@index([bank_account_id])
}

model BankTransfer {
  id                   Int      @id @default(autoincrement())
  store_id             Int
  source_account_id    Int
  destination_account_id Int
  transfer_date        DateTime @default(now())
  amount               Decimal  @db.Decimal(15, 4)
  reference_number     String   @unique
  description          String?
  status               String   @default("COMPLETED")
  journal_entry_id     Int?
  created_by           Int

  store                Store         @relation(fields: [store_id], references: [id])
  source_account       BankAccount   @relation("TransferSource", fields: [source_account_id], references: [id])
  destination_account  BankAccount   @relation("TransferDestination", fields: [destination_account_id], references: [id])

  @@index([store_id])
}

model CashForecast {
  id                   Int      @id @default(autoincrement())
  store_id             Int
  forecast_date        DateTime
  expected_inflows     Decimal  @default(0.0) @db.Decimal(15, 4)
  expected_outflows    Decimal  @default(0.0) @db.Decimal(15, 4)
  net_forecast         Decimal  @default(0.0) @db.Decimal(15, 4)
  generated_at         DateTime @default(now())

  store                Store    @relation(fields: [store_id], references: [id])

  @@index([store_id])
}

model CashPosition {
  id                   Int      @id @default(autoincrement())
  store_id             Int
  bank_account_id      Int
  position_date        DateTime @default(now())
  opening_balance      Decimal  @db.Decimal(15, 4)
  net_change           Decimal  @db.Decimal(15, 4)
  closing_balance      Decimal  @db.Decimal(15, 4)

  store                Store         @relation(fields: [store_id], references: [id])
  bank_account         BankAccount   @relation(fields: [bank_account_id], references: [id])

  @@index([store_id])
  @@index([bank_account_id])
}

// ---------------------------------------------------------
// ENTERPRISE FINANCIAL COMPLIANCE & ERP GO-LIVE
// ---------------------------------------------------------

model ComplianceCheck {
  id                   Int      @id @default(autoincrement())
  store_id             Int
  check_name           String
  check_type           String   // E.g., DATA_INTEGRITY, MODULE_DEPENDENCY
  status               String   // PASS, FAIL, WARNING
  details              String?
  executed_at          DateTime @default(now())

  store                Store    @relation(fields: [store_id], references: [id])

  @@index([store_id])
}

model InternalControl {
  id                   Int      @id @default(autoincrement())
  store_id             Int
  control_name         String
  description          String
  status               String   // PASS, FAIL
  last_verified        DateTime @default(now())

  store                Store    @relation(fields: [store_id], references: [id])

  @@index([store_id])
}

model AuditFinding {
  id                   Int      @id @default(autoincrement())
  store_id             Int
  finding_type         String   // E.g., UNBALANCED_JOURNAL, ORPHAN_RECORD
  severity             String   // HIGH, MEDIUM, LOW
  description          String
  reference_id         String?  // Optionally link to an offending entity ID
  resolved             Boolean  @default(false)
  created_at           DateTime @default(now())

  store                Store    @relation(fields: [store_id], references: [id])

  @@index([store_id])
}

model GoLiveChecklist {
  id                   Int      @id @default(autoincrement())
  store_id             Int
  module_name          String
  item_name            String
  is_completed         Boolean  @default(false)
  verified_at          DateTime?

  store                Store    @relation(fields: [store_id], references: [id])

  @@index([store_id])
}

model SystemCertification {
  id                   Int      @id @default(autoincrement())
  store_id             Int
  certification_date   DateTime @default(now())
  accounting_score     Decimal  @db.Decimal(5, 2)
  module_health_score  Decimal  @db.Decimal(5, 2)
  data_integrity_score Decimal  @db.Decimal(5, 2)
  security_score       Decimal  @db.Decimal(5, 2)
  performance_score    Decimal  @db.Decimal(5, 2)
  overall_status       String   // CERTIFIED, NOT_READY
  certified_by         Int      // User ID

  store                Store    @relation(fields: [store_id], references: [id])

  @@index([store_id])
}

model OrderEventLog {
  id          Int      @id @default(autoincrement())
  orderId     String
  storeId     Int
  userId      Int
  oldStatus   String?
  newStatus   String
  reason      String?
  createdAt   DateTime @default(now())

  @@index([orderId])
  @@index([storeId])
}
