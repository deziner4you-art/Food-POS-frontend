  session WasteSession  @relation(fields: [session_id], references: [id])
  product InventoryItem @relation(fields: [product_id], references: [id])
}

model InventoryBatch {
  id                 Int       @id @default(autoincrement())
  store_id           Int
  warehouse_id       Int?
  product_id         Int
  batch_number       String
  lot_number         String?
  manufacturing_date DateTime?
  expiry_date        DateTime?
  received_quantity  Float     @default(0)
  available_quantity Float     @default(0)
  reserved_quantity  Float     @default(0)
  consumed_quantity  Float     @default(0)
  waste_quantity     Float     @default(0)
  unit_cost          Float     @default(0)
  valuation_method   String?   @default("WEIGHTED_AVERAGE")
  status             String    @default("ACTIVE") // ACTIVE, EXPIRED, DEPLETED, QUARANTINED
  created_by         Int
  created_at         DateTime  @default(now())

  store                 Store                   @relation(fields: [store_id], references: [id])
  product               InventoryItem           @relation(fields: [product_id], references: [id])
  movements             BatchMovement[]
  reservations          BatchReservation[]
  WarehouseTransferLine WarehouseTransferLine[]
  ReservationAllocation ReservationAllocation[]
  ProductionOutput      ProductionOutput[]
  ProductionConsumption ProductionConsumption[]

  @@unique([store_id, warehouse_id, product_id, batch_number])
