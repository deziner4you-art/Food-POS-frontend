generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------
// CORE & MULTI-TENANT
// -------------------------------------------------------------
model Brand {
  id             Int      @id @default(autoincrement())
  name           String
  createdAt      DateTime @default(now())
  is_chain_store Boolean   @default(false)
  status         String    @default("ACTIVE") // ACTIVE, RECYCLED
  deleted_at     DateTime?
  deleted_by     String?
  deleted_reason String?
  restored_at    DateTime?
  restored_by    String?
  menu_strategy  String    @default("UNIFIED") // UNIFIED or INDEPENDENT

  currency       String @default("PKR")
  vat_percentage Float  @default(0)

  stores             Store[]
  users              User[]
  customers          Customer[]
  menus              Menu[]
  CmsBanner          CmsBanner[]
  CmsSettings        CmsSettings[]
  MarketingCampaigns MarketingCampaign[]
  ScheduledDiscounts ScheduledDiscount[]
  subscription       Subscription?

  userAssignments    UserAssignment[]
}

model Store {
  id              Int      @id @default(autoincrement())
  brand_id        Int
  name            String
  location        String?
  is_online       Boolean  @default(true)
  createdAt       DateTime @default(now())

  // Branch Specific Info
  owner_name      String?
  owner_phone     String?
  owner_email     String?
  address         String?
  map_pin         String?
  website         String?
  email           String?
  landline        String?
  whatsapp        String?
  order_no_prefix String?
  vat_percentage  Float    @default(0)

  status              String    @default("ACTIVE") // ACTIVE, SUSPENDED, MAINTENANCE, RECYCLED
  status_reason       String?
  status_changed_by   String?
  status_changed_at   DateTime?
  resume_at           DateTime?
  deleted_at          DateTime?
  deleted_by          String?
  deleted_reason      String?
  restored_at         DateTime?
  restored_by         String?

  // SaaS Package (per-branch)
  saas_package_id Int?
  saas_package    Package?  @relation(fields: [saas_package_id], references: [id])

  brand         Brand           @relation(fields: [brand_id], references: [id])
  users         User[]
  products      Product[]
  orders        Order[]
  inventory        InventoryItem[]
  recipes          Recipe[]
  recipeCategories RecipeCategory[]
  businessDays     BusinessDay[]
  modifierGroups   ModifierGroup[]
  availabilityRules AvailabilityRule[]
  cashFlows     CashFlow[]
  kots          KOT[]
  Vendor        Vendor[]
  PurchaseOrder PurchaseOrder[]
  goodsReceipts GoodsReceipt[]

  menus                 Menu[]                 @relation("MenuStores")
  assignedCategories    Category[]             @relation("CategoryStores")
  assignedProducts      Product[]              @relation("ProductStores")
  assignedCategoryGroups CategoryGroup[]        @relation("CategoryGroupStores")
  MarketingCampaign     MarketingCampaign[]    @relation("CampaignStores")
  socialAccount         BranchSocialAccount?
  terminalSessions      TerminalSession[]
  cmsSettings           CmsSettings?
  newsletterSubscribers NewsletterSubscriber[]

  // Accounting
  accountGroups         AccountGroup[]
  accounts              Account[]
  fiscalYears           FiscalYear[]
  accountingPeriods     AccountingPeriod[]
  journals              Journal[]
  journalEntries        JournalEntry[]
  journalEntryLines     JournalEntryLine[]
  voucherTypes          VoucherType[]
  general_ledgers       GeneralLedger[]
  vouchers              Voucher[]
  posting_rules         PostingRule[]
  exchangeRates         ExchangeRate[]
  costCenters           CostCenter[]
  profitCenters         ProfitCenter[]
  systemAccountMappings SystemAccountMapping[]
  InventoryMovement     InventoryMovement[]
  StockCountSession     StockCountSession[]
  WasteSession          WasteSession[]
  InventoryBatch        InventoryBatch[]
  outboundTransfers     WarehouseTransfer[]    @relation("SourceStore")
  inboundTransfers      WarehouseTransfer[]    @relation("DestStore")
  InventoryReservation  InventoryReservation[]
  ProductionOrder       ProductionOrder[]
  PeriodClosing         PeriodClosing[]
  financial_statements FinancialStatement[]
  budgets               Budget[]
  month_end_closings    MonthEndClosing[]
  year_end_closings     YearEndClosing[]
  userAssignments       UserAssignment[]
  asset_locations       AssetLocation[]
  fixed_assets          FixedAsset[]
  customer_receivables  CustomerReceivable[]
  customer_receipts     CustomerReceipt[]
  customer_credit_limits CustomerCreditLimit[]
  customer_agings       CustomerAging[]
  vendor_payables       VendorPayable[]
  vendor_payments       VendorPayment[]
  vendor_credit_terms   VendorCreditTerms[]
  vendor_agings         VendorAging[]
  bank_statements       BankStatement[]
  bank_reconciliations  BankReconciliation[]
  bank_accounts         BankAccount[]
  cash_transactions     CashTransaction[]
  bank_transfers        BankTransfer[]
  cash_forecasts        CashForecast[]
  cash_positions        CashPosition[]
  compliance_checks     ComplianceCheck[]
  internal_controls     InternalControl[]
  audit_findings        AuditFinding[]
  golive_checklists     GoLiveChecklist[]
  system_certifications SystemCertification[]

  // KDS Backend Foundation
  kitchenStations KitchenStation[]
  chefSessions    ChefSession[]
  stockRequests   StockRequest[]
  inventoryLocks  InventoryLock[]
}

model SystemAuditLog {
  id          Int      @id @default(autoincrement())
  action      String
  entity      String
  entity_id   Int?
  user_id     Int?
  user_name   String?
  details     Json?
  created_at  DateTime @default(now())
}

model TerminalSession {
  id               Int       @id @default(autoincrement())
  store_id         Int
  pin              String    @unique
  waiter_name      String
  device_id        String? // Client-generated persistent id (localStorage) — enables "remember device"
  device_name      String? // e.g. "Rooftop Tablet 01"
  table_no         String?
  socket_id        String? // Current live socket id; null when offline (but still "connected" per is_active)
  is_active        Boolean   @default(true) // false only when cashier disconnects or waiter logs out
  connected_at     DateTime?
  last_activity_at DateTime?
  logged_out_at    DateTime?
  createdAt        DateTime  @default(now())

  store Store @relation(fields: [store_id], references: [id])

  @@index([store_id])
  @@index([device_id])
}

// -------------------------------------------------------------
// ANALYTICS & REPORTS
// -------------------------------------------------------------
// -------------------------------------------------------------
// RBAC & USERS
// -------------------------------------------------------------
model Role {
  id             Int               @id @default(autoincrement())
  name           String // SuperAdmin, HeadOffice, BranchManager, Cashier, Rider
  permissions    Json // Modular feature toggling JSON (Legacy)
  users          User[]            // Legacy

  rolePermissions RolePermission[]
  assignments     UserAssignment[]
  parentRoles     RoleInheritance[] @relation("ChildRole")
  childRoles      RoleInheritance[] @relation("ParentRole")
}

model User {
  id                 Int      @id @default(autoincrement())
  brand_id           Int?
  store_id           Int?
  role_id            Int
  
  // Enterprise Fields
  emp_id             String?
  name               String
  email              String?
  phone              String   @unique
  designation        String?
  status             String   @default("ACTIVE") // ACTIVE, SUSPENDED, TERMINATED
  joining_date       DateTime?
  notes              String?

  hashedPin          String // For local credential caching
  must_change_password Boolean @default(false) // Force password reset on next login
  password_changed_at DateTime?
  password_reset_at  DateTime?
  password_reset_by  Int?
  refreshTokenHash   String? // For secure refresh token rotation
  image_url          String?
  module_permissions Json? // Per-user module access: {pos, kds, rider, admin, website, ...}
  rider_details      Json? // Additional rider specific information
  createdAt          DateTime @default(now())

  brand Brand? @relation(fields: [brand_id], references: [id])
  store Store? @relation(fields: [store_id], references: [id])
  role  Role   @relation(fields: [role_id], references: [id])

  // Audits & Tracking
  approved_voids Order[]       @relation("VoidApprover")
  rider_orders   Order[]       @relation("RiderOrders")
  started_days   BusinessDay[] @relation("DayStarter")
  closed_days    BusinessDay[] @relation("DayCloser")
  cash_flows     CashFlow[]

  assignments          UserAssignment[] @relation("UserAssignments")
  managed_assignments  UserAssignment[] @relation("ReportingManager")
  refresh_tokens       RefreshToken[]
}

// -------------------------------------------------------------
// NEW ENTERPRISE RBAC & IDENTITY
// -------------------------------------------------------------
// ENTERPRISE SESSION & REFRESH TOKENS
// -------------------------------------------------------------
model RefreshToken {
  id          Int       @id @default(autoincrement())
  user_id     Int
  token_hash  String    @unique
  device_id   String
  session_id  String
  is_revoked  Boolean   @default(false)
  expires_at  DateTime
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [user_id], references: [id])
}

// -------------------------------------------------------------

model PermissionGroup {
  id          Int          @id @default(autoincrement())
  module_name String       @unique
  description String?
  permissions Permission[]
}

model Permission {
  id          Int             @id @default(autoincrement())
  group_id    Int
  action      String
  resource    String
  description String?
  
  group       PermissionGroup @relation(fields: [group_id], references: [id])
  roles       RolePermission[]

  @@unique([group_id, resource, action]) // Ensures module.resource.action is unique
}

model RolePermission {
  id            Int        @id @default(autoincrement())
  role_id       Int
  permission_id Int
  
  role          Role       @relation(fields: [role_id], references: [id])
  permission    Permission @relation(fields: [permission_id], references: [id])

  @@unique([role_id, permission_id])
}

model RoleInheritance {
  id             Int  @id @default(autoincrement())
  parent_role_id Int
  child_role_id  Int

  parent_role    Role @relation("ParentRole", fields: [parent_role_id], references: [id])
  child_role     Role @relation("ChildRole", fields: [child_role_id], references: [id])

  @@unique([parent_role_id, child_role_id])
}

model UserAssignment {
  id                  Int       @id @default(autoincrement())
  user_id             Int
  role_id             Int
  brand_id            Int?
  store_id            Int?
  
  is_primary          Boolean   @default(false)
  status              String    @default("ACTIVE")
  effective_from      DateTime  @default(now())
  effective_to        DateTime?
  
  reporting_manager_id Int?
  created_by          Int?
  updated_by          Int?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user                User      @relation("UserAssignments", fields: [user_id], references: [id])
  role                Role      @relation(fields: [role_id], references: [id])
  brand               Brand?    @relation(fields: [brand_id], references: [id])
  store               Store?    @relation(fields: [store_id], references: [id])
  manager             User?     @relation("ReportingManager", fields: [reporting_manager_id], references: [id])
}

// -------------------------------------------------------------
// CRM & CUSTOMERS
// -------------------------------------------------------------
model Customer {
  id             Int      @id @default(autoincrement())
  brand_id       Int
  phone          String   @unique
  name           String
  address        String?
  total_orders   Int      @default(0)
  loyalty_points Int      @default(0)
  createdAt      DateTime @default(now())

  brand               Brand                @relation(fields: [brand_id], references: [id])
  orders              Order[]
  loyaltyTransactions LoyaltyTransaction[]
  receivables         CustomerReceivable[]
  credit_limits       CustomerCreditLimit[]
  agings              CustomerAging[]
}

// -------------------------------------------------------------
// INVENTORY & PRODUCTS
// -------------------------------------------------------------
// -------------------------------------------------------------
// SAAS BILLING & PRICING
// -------------------------------------------------------------

model Package {
  id             Int              @id @default(autoincrement())
  code           String           @unique // Auto Generated
  name           String
  description    String?
  currency       String           @default("USD")
  monthly_rental Float
  billing_cycle  String           @default("MONTHLY") // MONTHLY, QUARTERLY, YEARLY
  status         String           @default("ACTIVE") // ACTIVE, INACTIVE, ARCHIVED
  discount_pct   Float            @default(0)
  total_value    Float
  created_at     DateTime         @default(now())
  updated_at     DateTime         @updatedAt
  
  modules        PackageModule[]
  subscriptions  Subscription[]
  stores         Store[]
}

model PackageModule {
  id         Int     @id @default(autoincrement())
  package_id Int
  module_key String  // BASE_POS, INVENTORY, MARKETING, etc.
  price      Float
  config     Json?   // Feature-flag payload for this module, e.g. MARKETING:
                      // { allowedCampaignTypes: string[], socialPublishing: bool, tvBoard: bool, analytics: bool }

  package    Package @relation(fields: [package_id], references: [id])
}

model Subscription {
  id                Int       @id @default(autoincrement())
  brand_id          Int       @unique
  package_id        Int
  rental_amount     Float
  currency          String
  billing_cycle     String
  start_date        DateTime
  next_billing_date DateTime
  expiry_date       DateTime
  grace_period_days Int       @default(5)
  status            String    @default("ACTIVE") // ACTIVE, EXPIRED, GRACE_PERIOD, SUSPENDED
  suspend_reason    String?
  
  brand             Brand     @relation(fields: [brand_id], references: [id])
  package           Package   @relation(fields: [package_id], references: [id])
  payments          SubscriptionPayment[]
  billing_history   BillingHistory[]
}

model SubscriptionPayment {
  id              Int          @id @default(autoincrement())
  subscription_id Int
  amount_paid     Float
  payment_method  String
  payment_date    DateTime     @default(now())
  recorded_by     Int          // Super Admin ID
  reference_number String?
  remarks         String?
  
  subscription    Subscription @relation(fields: [subscription_id], references: [id])
}

model BillingHistory {
  id              Int          @id @default(autoincrement())
  subscription_id Int
  event_type      String       // RENEWED, UPGRADED, DOWNGRADED, PAUSED, SUSPENDED
  description     String
  created_at      DateTime     @default(now())
  
  subscription    Subscription @relation(fields: [subscription_id], references: [id])
}

model SaaSPricing {
  id            Int    @id @default(autoincrement())
  module_key    String // e.g., "BASE_POS", "KDS", "RIDER", "TV_BOARD"
  module_name   String
  price_monthly Float
  currency      String @default("USD") // Base currency for pricing

  @@unique([module_key, currency])
}

// -------------------------------------------------------------
// SCHEDULED DISCOUNTS & MARKETING
// -------------------------------------------------------------
// -------------------------------------------------------------
// MENU & CATALOG
// -------------------------------------------------------------
model Menu {
  id        Int      @id @default(autoincrement())
  brand_id  Int      @default(1)
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  brand          Brand           @relation(fields: [brand_id], references: [id])
  stores         Store[]         @relation("MenuStores")
  categories     Category[]
  categoryGroups CategoryGroup[]
}

// Menu Builder hierarchy (Sprint 28.7): Menu Collection -> Category Group -> Category -> Product.
// Products never link directly to a Category Group — only through a Category.
model CategoryGroup {
  id          Int     @id @default(autoincrement())
  menu_id     Int
  name        String
  description String?
  sort_order  Int     @default(0)
  icon        String?
  color       String?
  image_url   String?
  is_active   Boolean @default(true)

  // Sprint 28.8A — true only for the "Default Group" auto-created as a
  // holding bucket so Category.category_group_id is never null. Not a
  // user-created entity: excluded from the navigation contract's
  // category_groups list (its categories surface as flat/ungrouped there).
  // Still a fully real, manageable row everywhere else (admin CRUD, etc).
  is_system_default Boolean @default(false)

  // Channel Visibility
  visible_pos      Boolean @default(true)
  visible_website  Boolean @default(true)
  visible_waiter   Boolean @default(true)
  visible_qr_menu  Boolean @default(true)
  visible_kiosk    Boolean @default(true)
  visible_delivery Boolean @default(true)
  visible_takeaway Boolean @default(true)

  created_by Int?
  updated_by Int?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deleted_at DateTime? // Soft delete — restore clears this instead of a hard DELETE

  menu            Menu       @relation(fields: [menu_id], references: [id])
  assigned_stores Store[]    @relation("CategoryGroupStores")
  categories      Category[]

  @@index([menu_id])
}

model Category {
  id       Int    @id @default(autoincrement())
  store_id Int // Creator Store (Admin)
  menu_id  Int?
  // Hotfix: Category Groups are OPTIONAL (business requirement change) — a
  // restaurant may use Menu -> Categories -> Products with no groups at all.
  // Nullable, ON DELETE SET NULL: deleting a group never blocks and never
  // requires reassigning its categories anywhere — they simply become
  // ungrouped.
  category_group_id Int?
  name     String
  is_active   Boolean @default(true)
  sort_order  Int     @default(0)
  image_url   String?

  menu               Menu?               @relation(fields: [menu_id], references: [id])
  categoryGroup      CategoryGroup?      @relation(fields: [category_group_id], references: [id], onDelete: SetNull)
  assigned_stores    Store[]             @relation("CategoryStores")
  products           Product[]           @relation("ProductCategories")
  marketingCampaigns MarketingCampaign[] @relation("CampaignCategories")

  // Sprint 28.8D — Menu Builder list/filter performance
  // (category_group_id already indexed — Category_category_group_id_idx, Sprint 28.7)
  @@index([store_id])
  @@index([menu_id])
}

model Product {
  id         Int      @id @default(autoincrement())
  store_id   Int
  name       String
  price      Float
  cost       Float
  margin_pct Float // Dynamic margin calculation
  is_active  Boolean  @default(true)
  sku            String?
  barcode        String?
  image_url      String?
  thumbnail_url  String?
  mime_type      String?
  file_size      Int?
  description    String?
  internal_notes String?
  status         String   @default("APPROVED") // PENDING, APPROVED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt // Sprint 28.8D — Product List API requires "Updated At"

  store              Store               @relation(fields: [store_id], references: [id])
  categories         Category[]          @relation("ProductCategories")
  assigned_stores    Store[]             @relation("ProductStores")
  orderItems         OrderItem[]
  recipe_id          Int?
  recipe             Recipe?             @relation(fields: [recipe_id], references: [id])
  marketingCampaigns MarketingCampaign[] @relation("CampaignProducts")
  bogoBuyCampaigns   MarketingCampaign[] @relation("CampaignBuyProduct")
  bogoGetCampaigns   MarketingCampaign[] @relation("CampaignGetProduct")
  bundleCampaigns    MarketingCampaign[] @relation("CampaignBundleProducts")
  giftCampaigns      MarketingCampaign[] @relation("CampaignGiftProduct")
  variants           ProductVariant[]
  productions        ProductionOrder[]   @relation("TargetProduct")
  
  tax_rate             Float    @default(0)
  kitchen_station      String?  // Legacy free-text station label — kept for backward compatibility, still authoritative until a product is migrated to kitchen_station_id below.
  printer_group        String?
  kds_group            String?
  availability_rule_id Int?
  availabilityRule     AvailabilityRule? @relation(fields: [availability_rule_id], references: [id])
  modifierGroups       ProductModifierGroup[]

  // KDS Backend Foundation — additive, optional FK. When set, takes priority
  // over the legacy `kitchen_station` string for ticket routing; when null,
  // consumers fall back to the legacy string (see KitchenDashboardService).
  kitchen_station_id Int?
  kitchenStation     KitchenStation? @relation(fields: [kitchen_station_id], references: [id])

  // Sprint 28.8D — Menu Builder list/filter performance
  @@index([store_id])
  @@index([status])
}

// -------------------------------------------------------------
// PRODUCT REQUEST WORKFLOW (Branch proposes -> HQ approves -> Menu Product)
// -------------------------------------------------------------
model ProductRequest {
  id                 Int       @id @default(autoincrement())
  store_id           Int // Branch that submitted the request
  requested_by       Int // User id (Chef / Branch Manager)
  name               String
  description        String?
  category_id        Int?
  suggested_price    Float
  sku                String?
  image_url          String?
  thumbnail_url      String?
  recipe_notes       String?
  recipe_id          Int? // Optional link to an existing Recipe (Recipe Review stage)
  kitchen_station    String?
  status             String    @default("DRAFT") // DRAFT, SUBMITTED, UNDER_REVIEW, RECIPE_REVIEW, COSTING_REVIEW, APPROVED, REJECTED, PUBLISHED
  hq_comments        String?
  approved_by        Int?
  approved_at        DateTime?
  created_product_id Int? // Menu Product created on approval — original request kept for history
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  auditLog ProductRequestAuditLog[]

  @@index([store_id])
  @@index([status])
}

model ProductRequestAuditLog {
  id                Int      @id @default(autoincrement())
  product_request_id Int
  action            String // CREATED, SUBMITTED, REVIEWED, APPROVED, REJECTED, PUBLISHED, RETURNED_FOR_REVISION
  user_id           Int?
  comments          String?
  createdAt         DateTime @default(now())

  productRequest ProductRequest @relation(fields: [product_request_id], references: [id], onDelete: Cascade)

  @@index([product_request_id])
}

model ProductVariant {
  id         Int         @id @default(autoincrement())
  product_id Int
  name       String // e.g. "Small", "Medium"
  price      Float
  cost       Float?      @default(0)
  sku        String?
  barcode    String?
  recipe_id  Int?
  recipe     Recipe?     @relation(fields: [recipe_id], references: [id])
  product    Product     @relation(fields: [product_id], references: [id], onDelete: Cascade)
  OrderItem  OrderItem[]
}

model AvailabilityRule {
  id          Int       @id @default(autoincrement())
  store_id    Int
  name        String    
  type        String    @default("ALWAYS") 
  start_time  String?   
  end_time    String?   
  days        String?   
  
  store       Store     @relation(fields: [store_id], references: [id])
  products    Product[]
}

model ModifierGroup {
  id             Int       @id @default(autoincrement())
  store_id       Int
  name           String    
  is_required    Boolean   @default(false)
  min_selection  Int       @default(0)
  max_selection  Int       @default(1)
  
  store          Store     @relation(fields: [store_id], references: [id])
  modifiers      Modifier[]
  productLinks   ProductModifierGroup[]
}

model Modifier {
  id                Int       @id @default(autoincrement())
  modifier_group_id Int
  name              String    
  additional_price  Float     @default(0)
  
  modifierGroup     ModifierGroup @relation(fields: [modifier_group_id], references: [id], onDelete: Cascade)
}

model ProductModifierGroup {
  product_id        Int
  modifier_group_id Int
  
  product           Product       @relation(fields: [product_id], references: [id], onDelete: Cascade)
  modifierGroup     ModifierGroup @relation(fields: [modifier_group_id], references: [id], onDelete: Cascade)
  
  @@id([product_id, modifier_group_id])
}

model InventoryItem {
  id            Int    @id @default(autoincrement())
  store_id      Int
  name          String
  sku           String?
  barcode       String?
  quantity      Float // Negative inventory soft block allowed
  unit          String // kg, liter, piece
  reorder_level Float  @default(0)
  max_stock     Float  @default(0)
  unit_price    Float  @default(0) // Added for Recipe Costing

  store                    Store                      @relation(fields: [store_id], references: [id])
  transactions             InventoryTransactionLog[]
  recipes                  RecipeIngredient[]
  PurchaseOrderItem        PurchaseOrderItem[]
  TransitLoss              TransitLoss[]
  InventoryMovement        InventoryMovement[]
  StockCountLine           StockCountLine[]
  WasteLine                WasteLine[]
  InventoryBatch           InventoryBatch[]
  WarehouseTransferLine    WarehouseTransferLine[]
  InventoryReservationLine InventoryReservationLine[]
  ProductionOrderLine      ProductionOrderLine[]
  ProductionOutput         ProductionOutput[]
  ProductionConsumption    ProductionConsumption[]
  grnItems                 GoodsReceiptItem[]

  // KDS Backend Foundation
  stockRequests StockRequest[]
  locks         InventoryLock[]
}

model InventoryTransactionLog {
  id           Int      @id @default(autoincrement())
  inventory_id Int
  operation    String // ADD, SUBTRACT (Append-only Event Sourcing)
  amount       Float
  reason       String?
  changed_by   Int // User ID
  createdAt    DateTime @default(now())

  inventoryItem InventoryItem @relation(fields: [inventory_id], references: [id])
}

model RecipeCategory {
  id        Int      @id @default(autoincrement())
  store_id  Int
  name      String
  createdAt DateTime @default(now())
  
  store   Store    @relation(fields: [store_id], references: [id])
  recipes Recipe[]
}

model Recipe {
  id               Int      @id @default(autoincrement())
  store_id         Int
  category_id      Int?
  name             String
  yield            Float    @default(1)
  portion_size     Float?
  waste_percentage Float    @default(0)
  prep_time_mins   Int      @default(0)
  instructions     String?
  createdAt        DateTime @default(now())

  store       Store            @relation(fields: [store_id], references: [id])
  category    RecipeCategory?  @relation(fields: [category_id], references: [id])
  ingredients RecipeIngredient[]
  products    Product[]
  productVariants ProductVariant[]
}

// Recipe: ہر recipe میں کون کون سا raw material لگتا ہے
model RecipeIngredient {
  id           Int    @id @default(autoincrement())
  recipe_id    Int
  inventory_id Int
  quantity     Float // How much of this ingredient per 1 unit of recipe
  unit         String

  recipe    Recipe        @relation(fields: [recipe_id], references: [id], onDelete: Cascade)
  inventory InventoryItem @relation(fields: [inventory_id], references: [id])
}

// -------------------------------------------------------------
// BUSINESS DAY MANAGEMENT
// -------------------------------------------------------------
model BusinessDay {
  id           Int       @id @default(autoincrement())
  store_id     Int
  started_by   Int
  closed_by    Int?
  dayStart     DateTime
  dayClose     DateTime?
  openingFloat Float     @default(0)
  closingCash  Float?
  totalSales   Float?
  totalOrders  Int?
  status       String    @default("OPEN") // OPEN, CLOSED
  notes        String?
  createdAt    DateTime  @default(now())

  store   Store @relation(fields: [store_id], references: [id])
  starter User  @relation("DayStarter", fields: [started_by], references: [id])
  closer  User? @relation("DayCloser", fields: [closed_by], references: [id])

  orders    Order[]
  cashFlows CashFlow[]
  kots      KOT[]
}

// -------------------------------------------------------------
// CASH FLOW (Cash In / Cash Out)
// -------------------------------------------------------------
model CashFlow {
  id              Int      @id @default(autoincrement())
  store_id        Int
  business_day_id Int
  user_id         Int
  type            String // CASH_IN, CASH_OUT
  amount          Float
  comment         String?
  createdAt       DateTime @default(now())

  store       Store       @relation(fields: [store_id], references: [id])
  businessDay BusinessDay @relation(fields: [business_day_id], references: [id])
  user        User        @relation(fields: [user_id], references: [id])
}

// -------------------------------------------------------------
// ORDERS & TRANSACTIONS (Walk-in POS)
// -------------------------------------------------------------
model Order {
  id               Int      @id @default(autoincrement())
  store_id         Int
  business_day_id  Int?
  customer_id      Int?
  business_date    DateTime
  total_amount     Float
  discount         Float    @default(0)
  status           String // PENDING, PREPARING, READY, SETTLED, VOIDED
  order_source     String   @default("WALKIN") // WALKIN, ONLINE, CALL, WHATSAPP
  payment_method   String   @default("CASH") // CASH, CARD, COD, WALLET
  payment_status   String   @default("PAID") // PAID, PENDING_COD
  rider_id         Int? // User ID with Rider role
  delivery_address String?
  is_offline       Boolean  @default(false)
  table_no         String? // For dine-in
  terminal_session_id Int? // Waiter terminal that created this order, if any

  // Audit Trail
  created_by       Int // Cashier
  void_reason      String?
  void_approved_by Int? // Manager

  // Feedback
  customer_feedback String?
  rating            Int?
  delivery_info     Json?

  // MARKETING-002: Promotion Execution Engine attribution
  promotion_id       Int?
  promotion_type     String? // PERCENTAGE, FLAT, BOGO, BUNDLE, COMBO, FREE_GIFT, HAPPY_HOUR
  promotion_name     String?
  promotion_discount Float?  @default(0)
  gift_items         Json?   // [{product_id, name, qty}] — Free Gift line(s)
  bogo_items         Json?   // [{product_id, name, qty, rewardUnits}] — BOGO reward line(s)
  bundle_id          Int?    // MarketingCampaign.id when a bundle/combo price applied
  combo_id           Int?

  // MARKETING-003: full promotion-decision audit trail on the order itself
  applied_rules       Json?   // human-readable list of every rule that applied (mirrors PricingService.appliedRules)
  rejected_promotions Json?   // [{type: 'coupon'|'loyalty'|'cashier_discount', reason}] — what was blocked and why
  manager_override_by Int?    // User ID who authorized a Manual Override, if any
  coupon_blocked      Boolean @default(false)
  loyalty_blocked     Boolean @default(false)

  promotion          MarketingCampaign? @relation(fields: [promotion_id], references: [id])

  store       Store        @relation(fields: [store_id], references: [id])
  customer    Customer?    @relation(fields: [customer_id], references: [id])
  businessDay BusinessDay? @relation(fields: [business_day_id], references: [id])
  approver    User?        @relation("VoidApprover", fields: [void_approved_by], references: [id])
  rider       User?        @relation("RiderOrders", fields: [rider_id], references: [id])
  items       OrderItem[]
  kot         KOT?
  onlineOrder OnlineOrder?
  createdAt   DateTime     @default(now())
}

model OrderItem {
  id           Int     @id @default(autoincrement())
  order_id     Int
  product_id   Int
  variant_id   Int?
  quantity     Int
  price        Float
  special_inst String? // "Extra Mayo" printed in bold/Urdu KOT

  order   Order           @relation(fields: [order_id], references: [id])
  product Product         @relation(fields: [product_id], references: [id])
  variant ProductVariant? @relation(fields: [variant_id], references: [id])
}

// -------------------------------------------------------------
// RESTAURANT TABLE MANAGEMENT (Dine-In)
// -------------------------------------------------------------
model RestaurantTable {
  id               Int      @id @default(autoincrement())
  store_id         Int
  label            String // e.g. "T1", "VIP-2" — matches Order.table_no
  status           String   @default("AVAILABLE") // AVAILABLE, OCCUPIED, RESERVED, CLEANING
  current_order_id Int? // Active order currently seated at this table
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([store_id, label])
  @@index([store_id])
  @@index([current_order_id])
}

// -------------------------------------------------------------
// KOT — Kitchen Order Ticket (KDS)
// -------------------------------------------------------------
model KOT {
  id              Int       @id @default(autoincrement())
  store_id        Int
  order_id        Int       @unique
  business_day_id Int?
  items           Json // [{name, qty, specialInst, category}]
  status          String    @default("NEW") // NEW, PREPARING, READY, CANCELLED
  printCount      Int       @default(0)
  acceptedAt      DateTime?
  readyAt         DateTime?
  createdAt       DateTime  @default(now())

  store       Store        @relation(fields: [store_id], references: [id])
  order       Order        @relation(fields: [order_id], references: [id])
  businessDay BusinessDay? @relation(fields: [business_day_id], references: [id])

  inventoryLocks InventoryLock[]
}

// -------------------------------------------------------------
// KDS BACKEND FOUNDATION (Kitchen Stations, Chef Auth, Stock
// Requests, Inventory Locks) — additive only, no existing model
// or column touched. Mirrors the TerminalSession PIN-pairing
// pattern (see terminal.service.ts) and the CampaignAuditLog /
// void-order manager-PIN patterns already used elsewhere.
// -------------------------------------------------------------

model KitchenStation {
  id         Int      @id @default(autoincrement())
  store_id   Int
  name       String
  is_active  Boolean  @default(true)
  sort_order Int      @default(0)
  createdAt  DateTime @default(now())

  store         Store          @relation(fields: [store_id], references: [id])
  products      Product[]
  chefSessions  ChefSession[]
  stockRequests StockRequest[]

  @@unique([store_id, name])
  @@index([store_id])
}

// PIN-paired kitchen-staff session — same shape/lifecycle as TerminalSession,
// but scoped to a Chef/kitchen role rather than a Waiter, and optionally
// bound to one station.
model ChefSession {
  id                 Int       @id @default(autoincrement())
  store_id           Int
  pin                String    @unique
  chef_name          String
  kitchen_station_id Int?
  device_id          String?
  device_name        String?
  socket_id          String?
  is_active          Boolean   @default(true)
  connected_at       DateTime?
  last_activity_at   DateTime?
  logged_out_at      DateTime?
  createdAt          DateTime  @default(now())

  store   Store           @relation(fields: [store_id], references: [id])
  station KitchenStation? @relation(fields: [kitchen_station_id], references: [id])
  stockRequests StockRequest[]

  @@index([store_id])
  @@index([device_id])
}

// A kitchen station running low/out of an ingredient requests more from
// inventory/management. Read-model only — does not itself move stock;
// approval/fulfillment is a manual InventoryItem adjustment by whoever
// actions the request (kept simple deliberately, matches project scope).
model StockRequest {
  id                 Int       @id @default(autoincrement())
  store_id           Int
  inventory_id       Int
  kitchen_station_id Int?
  chef_session_id    Int?
  requested_by_name  String?
  requested_qty      Float
  unit               String
  status             String    @default("PENDING") // PENDING, APPROVED, FULFILLED, REJECTED
  reason             String?
  approved_by        Int?
  fulfilled_qty      Float?
  createdAt          DateTime  @default(now())
  resolvedAt         DateTime?

  store       Store           @relation(fields: [store_id], references: [id])
  inventory   InventoryItem   @relation(fields: [inventory_id], references: [id])
  station     KitchenStation? @relation(fields: [kitchen_station_id], references: [id])
  chefSession ChefSession?    @relation(fields: [chef_session_id], references: [id])

  @@index([store_id])
  @@index([inventory_id])
}

// A hold placed on an inventory item — e.g. a chef flags it 86'd/out mid-shift.
// While `is_active`, Recipe Availability treats the item as unavailable
// regardless of its real `quantity`. Only a manager PIN-unlock (mirrors the
// void-order manager_pin pattern) can release it — see InventoryLockService.
model InventoryLock {
  id           Int       @id @default(autoincrement())
  store_id     Int
  inventory_id Int
  kot_id       Int?
  reason       String?
  locked_by    Int?
  is_active    Boolean   @default(true)
  createdAt    DateTime  @default(now())
  releasedAt   DateTime?
  released_by  Int?

  store     Store         @relation(fields: [store_id], references: [id])
  inventory InventoryItem @relation(fields: [inventory_id], references: [id])
  kot       KOT?          @relation(fields: [kot_id], references: [id])

  @@index([store_id])
  @@index([inventory_id])
}

// -------------------------------------------------------------
// ONLINE ORDERS & TRACKING QUEUE
// -------------------------------------------------------------
model OnlineOrder {
  id               Int      @id @default(autoincrement())
  store_id         Int      @default(1)
  orderId          Int?
  status           String   @default("PENDING") // PENDING, ACCEPTED, DISPATCHED, SETTLED
  kdsStatus        String   @default("PENDING") // PENDING, ACCEPTED, PREPARING, READY
  type             String   @default("Online")
  source           String
  customer         String
  customerPhone    String   @default("")
  customerAddress  String   @default("")
  items            String // JSON string of items ordered or raw text description
  totalAmount      String
  // Customer's stated preference at checkout (CASH/CARD/COD/WALLET) --
  // intent, not a completed transaction: no payment gateway exists yet, so
  // this is what seeds the real POS Order's payment_method at Accept time
  // instead of that always being hardcoded to CASH. Nullable/optional so
  // every pre-existing OnlineOrder row (created before this field existed)
  // stays valid without a backfill.
  paymentMethod    String?
  notes            String   @default("")
  prepTimeMinutes  Int      @default(0)
  estimatedReadyAt String   @default("")
  timePlaced       String
  riderAssigned    Boolean  @default(false)
  // Atomic claim lock: the first rider to PATCH /rider-orders/:id/claim wins
  // (RiderService.claimOrder does a conditional updateMany WHERE
  // claimedByRiderId IS NULL); every other rider's identical request then
  // matches 0 rows and gets a 409. Nullable/optional so every pre-existing
  // row stays valid without a backfill. claimedByRiderName is a denormalized
  // snapshot (no Rider model exists — riders are Users) purely so the POS
  // delivery card and the rider app can display who has the order without
  // an extra join.
  claimedByRiderId   Int?
  claimedByRiderName String?
  feedback         Json?
  delivery         Json?
  createdAt        DateTime @default(now())

  // Links to the real kitchen ticket created when this online order is
  // first confirmed — lets it flow through the exact same Accept/
  // Preparing/Ready pipeline (and rider-notification bridge) POS delivery
  // orders already use, instead of kdsStatus being a string nobody in the
  // kitchen actually drives. Nullable: not set until CONFIRMED.
  posOrderId Int?   @unique
  posOrder   Order? @relation(fields: [posOrderId], references: [id])
}

// -------------------------------------------------------------
// LOYALTY WALLET
// -------------------------------------------------------------
model LoyaltyTransaction {
  id          Int      @id @default(autoincrement())
  customer_id Int
  order_id    Int?
  type        String // EARN, REDEEM
  points      Int
  description String?
  createdAt   DateTime @default(now())

  customer Customer @relation(fields: [customer_id], references: [id])
}

// -------------------------------------------------------------
// VENDOR & SUPPLY CHAIN
// -------------------------------------------------------------

model Vendor {
  id             Int      @id @default(autoincrement())
  store_id       Int
  name           String
  phone          String?
  email          String?
  status         String   @default("ACTIVE")
  contact_person String?
  address        String?
  tax_number     String?
  payment_terms  String?
  credit_limit   Float    @default(0)
  notes          String?
  ledger_balance Float    @default(0) // Negative means we owe them
  createdAt      DateTime @default(now())

  store          Store               @relation(fields: [store_id], references: [id])
  purchaseOrders PurchaseOrder[]
  payables       VendorPayable[]
  credit_terms   VendorCreditTerms[]
  agings         VendorAging[]
  ledgerEntries  VendorLedgerEntry[]
}

model PurchaseOrder {
  id             Int       @id @default(autoincrement())
  store_id       Int
  vendor_id      Int
  po_number      String?   @unique
  status         String    @default("DRAFT") // DRAFT, PENDING, APPROVED, PARTIALLY_RECEIVED, COMPLETED, CANCELLED
  payment_status String    @default("UNPAID") // UNPAID, PAID, PARTIAL
  subtotal       Float     @default(0)
  discount       Float     @default(0)
  tax            Float     @default(0)
  shipping_cost  Float     @default(0)
  other_charges  Float     @default(0)
  grand_total    Float     @default(0)
  total_amount   Float     @default(0)
  created_by     Int       @default(1)
  approved_by    Int?
  approvedAt     DateTime?
  notes          String?
  attachments    String?
  createdAt      DateTime  @default(now())
  deliveredAt    DateTime?

  store         Store               @relation(fields: [store_id], references: [id])
  vendor        Vendor              @relation(fields: [vendor_id], references: [id])
  items         PurchaseOrderItem[]
  goodsReceipts GoodsReceipt[]
}

model PurchaseOrderItem {
  id            Int    @id @default(autoincrement())
  po_id         Int
  inventory_id  Int
  ordered_qty   Float
  received_qty  Float  @default(0)
  remaining_qty Float  @default(0)
  unit          String @default("pcs")
  unit_cost     Float  @default(0)
  price_unit    Float  @default(0)
  discount      Float  @default(0)
  tax           Float  @default(0)
  line_total    Float  @default(0)

  purchaseOrder PurchaseOrder      @relation(fields: [po_id], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem      @relation(fields: [inventory_id], references: [id])
  transitLosses TransitLoss[]
  grnItems      GoodsReceiptItem[]
}

model GoodsReceipt {
  id             Int      @id @default(autoincrement())
  store_id       Int
  po_id          Int
  receipt_number String   @unique
  invoice_number String?
  received_by    Int
  receivedAt     DateTime @default(now())
  notes          String?
  attachments    String?

  store         Store              @relation(fields: [store_id], references: [id])
  purchaseOrder PurchaseOrder      @relation(fields: [po_id], references: [id], onDelete: Cascade)
  items         GoodsReceiptItem[]
}

model GoodsReceiptItem {
  id           Int       @id @default(autoincrement())
  grn_id       Int
  po_item_id   Int
  inventory_id Int
  received_qty Float
  rejected_qty Float     @default(0)
  damaged_qty  Float     @default(0)
  unit_cost    Float
  expiry_date  DateTime?
  batch_number String?

  goodsReceipt  GoodsReceipt      @relation(fields: [grn_id], references: [id], onDelete: Cascade)
  poItem        PurchaseOrderItem @relation(fields: [po_item_id], references: [id])
  inventoryItem InventoryItem     @relation(fields: [inventory_id], references: [id])
}

model VendorLedgerEntry {
  id            Int      @id @default(autoincrement())
  vendor_id     Int
  type          String   // INVOICE, PAYMENT, ADJUSTMENT
  reference     String?  // e.g. PO-001 or GRN-001
  amount        Float
  balance_after Float
  createdAt     DateTime @default(now())

  vendor Vendor @relation(fields: [vendor_id], references: [id], onDelete: Cascade)
}

model TransitLoss {
  id           Int      @id @default(autoincrement())
  po_item_id   Int
  inventory_id Int
  lost_qty     Float
  reason       String? // Auto-generated or manual override
  createdAt    DateTime @default(now())

  poItem        PurchaseOrderItem @relation(fields: [po_item_id], references: [id])
  inventoryItem InventoryItem     @relation(fields: [inventory_id], references: [id])
}

// -------------------------------------------------------------
// WEBSITE CMS
// -------------------------------------------------------------
model CmsBanner {
  id           Int      @id @default(autoincrement())
  brand_id     Int      @default(1)
  title        String
  subtitle     String?
  imageUrl     String
  linkUrl      String?
  buttonText   String?
  isActive     Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())

  brand Brand @relation(fields: [brand_id], references: [id])
}

model CmsSettings {
  id             Int     @id @default(autoincrement())
  brand_id       Int     @default(1)
  store_id       Int?    @unique
  siteTitle      String  @default("D4U Restaurant")
  contactPhone   String?
  contactEmail   String?
  address        String?
  googleMapUrl   String?
  facebookUrl    String?
  instagramUrl   String?
  whatsappNumber String?
  twitterUrl     String?
  youtubeUrl     String?
  aboutText      String?
  companyText    String?

  // Feature Flags / Module Toggles
  module_auth_enabled     Boolean @default(false)
  module_kds_enabled      Boolean @default(true)
  module_loyalty_enabled  Boolean @default(false)
  module_payments_enabled Boolean @default(false)

  // KDS Inventory Unlock — a per-branch PIN, separate from individual
  // manager accounts' own hashedPin (User.hashedPin), that lets any
  // manager physically at this branch unlock the Inventory tab on the
  // Kitchen Display. Hashed with bcrypt, same as User.hashedPin — never
  // stored or returned as plaintext.
  inventoryUnlockPinHash String?

  updatedAt DateTime @updatedAt

  brand Brand  @relation(fields: [brand_id], references: [id])
  store Store? @relation(fields: [store_id], references: [id])
}

model MarketingCampaign {
  id               Int      @id @default(autoincrement())
  brand_id         Int      @default(1)
  title            String
  description      String?
  discount_pct     Float
  image_url        String?
  is_active        Boolean  @default(true)
  published_pos    Boolean  @default(false)
  published_web    Boolean  @default(false)
  published_social Boolean  @default(false)
  createdAt        DateTime @default(now())

  brand               Brand      @relation(fields: [brand_id], references: [id])
  target_stores       Store[]    @relation("CampaignStores")
  target_categories   Category[] @relation("CampaignCategories")
  target_products     Product[]  @relation("CampaignProducts")
  status              String     @default("active")
  scheduled_at        DateTime?
  end_date            DateTime?
  published_facebook  Boolean    @default(false)
  published_instagram Boolean    @default(false)
  published_tv        Boolean    @default(false)

  // Status Lifecycle: DRAFT, SCHEDULED, RUNNING, PAUSED, COMPLETED, EXPIRED, ARCHIVED
  analytics           CampaignAnalytics[]
  
  // Phase 2 Prep
  priority            Int        @default(0)
  allow_stacking      Boolean    @default(false)
  published_email     Boolean    @default(false)
  published_sms       Boolean    @default(false)
  published_whatsapp  Boolean    @default(false)
  published_push      Boolean    @default(false)
  ab_test_group       String?
  ab_test_parent_id   Int?

  audit_logs          CampaignAuditLog[]

  // MARKETING-001: campaign type + BOGO foundation
  campaign_type       String     @default("PERCENTAGE") // PERCENTAGE, FLAT, BOGO, BUY_X_GET_Y, BUNDLE, COMBO, FREE_GIFT
  flat_discount_amount Float?    // Used when campaign_type = FLAT
  buy_product_id      Int?       // BOGO: product the customer must buy
  buy_qty             Int        @default(1)
  get_product_id      Int?       // BOGO: product the customer receives as the reward
  reward_type         String?    @default("FREE") // FREE, PERCENTAGE
  reward_qty          Int        @default(1)
  published_qr        Boolean    @default(false) // Foundation — QR Menu (future)
  published_kiosk     Boolean    @default(false) // Foundation — Self-Ordering Kiosk (future)

  buyProduct          Product?   @relation("CampaignBuyProduct", fields: [buy_product_id], references: [id])
  getProduct          Product?   @relation("CampaignGetProduct", fields: [get_product_id], references: [id])
  publications        CampaignPublication[]

  // MARKETING-002: Bundle / Combo (fixed-price product sets — same execution path)
  bundle_products     Product[]  @relation("CampaignBundleProducts")
  bundle_price        Float?

  // MARKETING-002: Free Gift
  min_spend           Float?     // Spend threshold that unlocks the gift
  gift_product_id     Int?
  giftProduct         Product?   @relation("CampaignGiftProduct", fields: [gift_product_id], references: [id])

  // MARKETING-002: Happy Hours / time-window (optional, layers on top of any campaign_type)
  active_days         String?    // CSV weekday abbreviations, e.g. "Fri,Sat" — null = every day
  active_time_start   String?    // "HH:mm" — null = no time restriction
  active_time_end     String?    // "HH:mm"
  active_dates        String?    // CSV specific ISO dates, e.g. for Ramadan/one-off dates
  show_countdown      Boolean    @default(false)

  orders              Order[]

  // MARKETING-003: governance — soft delete (never hard-delete a campaign)
  deleted_at          DateTime?
  deleted_by          Int?
  archived_reason     String?

  // MARKETING-003: versioning / rollback
  version             Int        @default(1)
  versions            CampaignVersion[]
  created_by          Int?
  updated_by          Int?

  // MARKETING-003: approval workflow — separate from the operational `status`
  // lifecycle (RUNNING/SCHEDULED/EXPIRED/...) so existing behavior is
  // unaffected unless a store explicitly opts into requiring approval.
  // DRAFT, PENDING_APPROVAL, APPROVED, REJECTED
  approval_status     String     @default("APPROVED")
  rejection_reason    String?
  submitted_by        Int?
  approved_by         Int?
  approved_at         DateTime?

  // MARKETING-003: multi-branch cloning lineage
  cloned_from_id      Int?
  cloned_from         MarketingCampaign?  @relation("CampaignClones", fields: [cloned_from_id], references: [id])
  clones              MarketingCampaign[] @relation("CampaignClones")
}

// MARKETING-003: one immutable snapshot per edit — never overwrite history, rollback supported.
model CampaignVersion {
  id          Int      @id @default(autoincrement())
  campaign_id Int
  version     Int
  data        Json // full campaign field snapshot BEFORE the edit that created this version
  changed_by  Int?
  createdAt   DateTime @default(now())

  campaign MarketingCampaign @relation(fields: [campaign_id], references: [id], onDelete: Cascade)

  @@index([campaign_id])
}

// Prepares social-channel publishing without building a scheduler/poster —
// one record per (campaign, channel) marks intent to publish; an external
// job/integration can pick these up later.
model CampaignPublication {
  id          Int      @id @default(autoincrement())
  campaign_id Int
  channel     String // FACEBOOK, INSTAGRAM
  status      String   @default("PENDING") // PENDING, PUBLISHED, FAILED
  createdAt   DateTime @default(now())

  campaign MarketingCampaign @relation(fields: [campaign_id], references: [id], onDelete: Cascade)

  @@index([campaign_id])
}

model CampaignAnalytics {
  id               Int               @id @default(autoincrement())
  campaign_id      Int
  date             DateTime          @db.Date
  hour             Int?              // Optional hourly granularity (0-23)
  store_id         Int?              // Optional branch-wise slicing

  campaign         MarketingCampaign @relation(fields: [campaign_id], references: [id], onDelete: Cascade)
  views            Int               @default(0)
  impressions      Int               @default(0)
  menu_opens       Int               @default(0)
  product_clicks   Int               @default(0)
  offer_clicks     Int               @default(0)
  cart_adds        Int               @default(0)
  orders_generated Int               @default(0)
  revenue_generated Float            @default(0.0)
  discount_cost    Float             @default(0.0)
  profit_impact    Float             @default(0.0)
  new_customers    Int               @default(0)
  returning_customers Int            @default(0)
  free_items_given Int               @default(0) // BOGO — units given away as the reward
  blocked_coupons  Int               @default(0) // Manual coupon/loyalty attempts rejected due to an active company promotion
  blocked_loyalty  Int               @default(0)

  updatedAt        DateTime          @updatedAt

  @@unique([campaign_id, date, hour, store_id], name: "campaign_date_hour_store")
}

model CampaignAuditLog {
  id               Int               @id @default(autoincrement())
  campaign_id      Int
  user_id          Int?              // Optional: which user made the change
  action           String            // e.g., CREATED, PAUSED, EXPIRED, EDITED, PUBLISHED, APPROVED, REJECTED, DELETED, RESTORED, CLONED, ROLLED_BACK
  changes          String?           @db.Text // JSON string describing what changed
  createdAt        DateTime          @default(now())

  // MARKETING-003: enterprise audit — where/how the action was taken
  store_id         Int?
  ip_address       String?
  device           String?           @db.Text // User-Agent string
  previous_value   String?           @db.Text
  new_value        String?           @db.Text

  campaign         MarketingCampaign @relation(fields: [campaign_id], references: [id], onDelete: Cascade)
}

